[
  {
    "type": "function",
    "function": {
      "name": "create_reminder",
      "description": "创建一条提醒事项",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "提醒的标题"
          },
          "due": {
            "type": "string",
            "description": "截止时间，格式 2026-06-04 18:00，可选"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_reminders",
      "description": "当用户想查看、修改、删除或完成提醒前，用它列出当前未完成提醒及其 id。用户提到时间范围时通过 start/end 参数缩小范围",
      "parameters": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "时间范围起点，格式 YYYY-MM-DD HH:MM，可选。例如「今天」用今天 00:00，「本周」用本周一 00:00，「明天」用明天 00:00。仅在用户提到时间范围时传入。"
          },
          "end": {
            "type": "string",
            "description": "时间范围终点，格式 YYYY-MM-DD HH:MM，可选。例如「今天」用今天 23:59，「本周」用周日 23:59，「未来三天」用第三天的 23:59。"
          },
          "include_undated": {
            "type": "boolean",
            "description": "是否一并返回没有截止时间的提醒，默认 false；仅在传了 start 或 end 时生效。"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "complete_reminder",
      "description": "标记指定id的提醒事项为已完成",
      "parameters": {
        "type": "object",
        "properties": {
          "reminder_id": {
            "type": "string",
            "description": "提醒事项的id"
          }
        },
        "required": [
          "reminder_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_reminder",
      "description": "删除指定id的提醒事项",
      "parameters": {
        "type": "object",
        "properties": {
          "reminder_id": {
            "type": "string",
            "description": "提醒事项的id"
          }
        },
        "required": [
          "reminder_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_reminder",
      "description": "根据id更新提醒事项",
      "parameters": {
        "type": "object",
        "properties": {
          "reminder_id": {
            "type": "string",
            "description": "提醒事项的id"
          },
          "new_title": {
            "type": "string",
            "description": "新的标题"
          },
          "new_due": {
            "type": "string",
            "description": "新的due date， 格式为2026-06-04 18:00"
          }
        },
        "required": [
          "reminder_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_search",
      "description": "联网搜索实时信息。当用户问到需要最新外部信息才能回答的问题（天气、新闻、股价、汇率、比分、当前事件、某地某店营业状态等）时调用；与提醒事项无关的实时类问题也走这里。纯闲聊、常识题、日期推算、用户自己的提醒事项不要调。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "用于联网搜索的查询语句，尽量包含时间和地点等关键限定词，例如『杭州 明天 天气』。"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  }
]
