# ===== 阿里云百炼（通义千问 qwen-plus）=====
# 获取地址：https://bailian.console.aliyun.com/
# 控制台 → API-KEY 管理 → 创建/查看 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== 火山引擎（豆包语音识别）=====
# 获取地址：https://console.volcengine.com/speech/
# 开通「录音文件识别极速版」后，在控制台获取 App ID 和 Access Token
APP_ID=your_volcengine_app_id_here
ACCESS_TOKEN=your_volcengine_access_token_here

# ===== 火山引擎（豆包语音合成 TTS）=====
# 使用「大模型语音合成 V3 双向流式 WebSocket」接口：
# https://www.volcengine.com/docs/6561/1329505?lang=zh
#
# TTS_VOICE_TYPE 是音色 ID。可在火山控制台音色列表或 ListSpeakers 接口中查询。
# 示例：zh_female_vv_uranus_bigtts、zh_female_cancan_mars_bigtts
TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts

# TTS_RESOURCE_ID 是语音合成模型资源 ID。
# 使用豆包语音合成模型 2.0 音色时，可配置为 seed-tts-2.0。
# 如果不填写，代码会按音色类型自动选择默认资源 ID。
TTS_RESOURCE_ID=seed-tts-2.0

# 双向流式 WebSocket 接入地址。通常无需修改。
TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
